<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="root" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinal.viewController.PrimaryViewController">

    <!-- MENÚ LATERAL -->
    <left>
        <VBox prefWidth="250.0" spacing="8.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="30.0" />
            </padding>
            <children>
                <Label styleClass="text-title" text="MonederoX" textFill="WHITE">
                    <VBox.margin>
                        <Insets bottom="5.0" left="10.0" />
                    </VBox.margin>
                </Label>
                <Label fx:id="lblRango" styleClass="text-subtitle" text="Rango" textFill="#a855f7">
                    <VBox.margin>
                        <Insets bottom="14.0" left="10.0" />
                    </VBox.margin>
                </Label>

                <!-- Cliente activo: todas las pantallas trabajan con este cliente -->
                <Label styleClass="text-subtitle" text="CLIENTE ACTIVO" style="-fx-font-size: 11px;">
                    <VBox.margin>
                        <Insets left="10.0" />
                    </VBox.margin>
                </Label>
                <ComboBox fx:id="cmbCliente" maxWidth="Infinity" promptText="Seleccione un cliente">
                    <VBox.margin>
                        <Insets bottom="16.0" />
                    </VBox.margin>
                </ComboBox>

                <Button fx:id="btnResumen" maxWidth="Infinity" mnemonicParsing="false" styleClass="sidebar-btn" text="📊 Resumen General" />
                <Button fx:id="btnTransacciones" maxWidth="Infinity" mnemonicParsing="false" styleClass="sidebar-btn" text="💸 Transacciones" />
                <Button fx:id="btnProgramar" maxWidth="Infinity" mnemonicParsing="false" styleClass="sidebar-btn" text="⏱️ Pagos Programados" />
                <Button fx:id="btnAnalisis" maxWidth="Infinity" mnemonicParsing="false" styleClass="sidebar-btn" text="🚨 Análisis y Alertas" />
                <Button fx:id="btnBeneficios" maxWidth="Infinity" mnemonicParsing="false" styleClass="sidebar-btn" text="🎁 Mis Beneficios" />
                <Button fx:id="btnMonederos" maxWidth="Infinity" mnemonicParsing="false" styleClass="sidebar-btn" text="👛 Monederos" />
                <Button fx:id="btnClientes" maxWidth="Infinity" mnemonicParsing="false" styleClass="sidebar-btn" text="👥 Gestión Clientes" />
            </children>
        </VBox>
    </left>

    <!-- ÁREA CENTRAL: PrimaryViewController carga aquí la pantalla elegida -->
    <center>
        <StackPane fx:id="contenedor" BorderPane.alignment="CENTER" />
    </center>
</BorderPane>
