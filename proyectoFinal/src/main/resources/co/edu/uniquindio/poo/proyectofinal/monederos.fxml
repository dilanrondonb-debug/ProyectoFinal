<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18.0" styleClass="vista" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinal.viewController.MonederosViewController">
    <padding>
        <Insets bottom="28.0" left="30.0" right="30.0" top="28.0" />
    </padding>
    <children>
        <Label styleClass="text-title" text="Monederos del cliente" />

        <VBox spacing="12.0" styleClass="card">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label styleClass="text-subtitle" text="Tipo" />
                        <ComboBox fx:id="cmbTipo" prefWidth="160.0" />
                        <Label styleClass="text-subtitle" text="Nombre" />
                        <TextField fx:id="txtNombre" promptText="Ej: Ahorro viaje" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onAgregar" styleClass="btn-primary" text="Agregar monedero" />
                    </children>
                </HBox>
                <Label fx:id="lblEstado" wrapText="true" />
            </children>
        </VBox>

        <TableView fx:id="tabla" minHeight="160.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" />
                <TableColumn fx:id="colTipo" text="Tipo" />
                <TableColumn fx:id="colId" text="ID" />
                <TableColumn fx:id="colSaldo" text="Saldo" />
                <TableColumn fx:id="colComision" text="Comisión por retiro" />
                <TableColumn fx:id="colEstado" text="Estado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
