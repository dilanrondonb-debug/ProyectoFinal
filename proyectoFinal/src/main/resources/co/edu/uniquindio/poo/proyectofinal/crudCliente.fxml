<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18.0" styleClass="vista" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinal.viewController.ClienteViewController">
    <padding>
        <Insets bottom="28.0" left="30.0" right="30.0" top="28.0" />
    </padding>
    <children>
        <Label styleClass="text-title" text="Gestión de clientes" />

        <VBox spacing="14.0" styleClass="card">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="80.0" styleClass="text-subtitle" text="Cédula" />
                        <TextField fx:id="txtCedula" promptText="Ej: 1094000003" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="80.0" styleClass="text-subtitle" text="Nombre" />
                        <TextField fx:id="txtNombre" promptText="Nombre completo" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="80.0" styleClass="text-subtitle" text="Correo" />
                        <TextField fx:id="txtCorreo" promptText="nombre@correo.com" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label prefWidth="80.0" styleClass="text-subtitle" text="Teléfono" />
                        <TextField fx:id="txtTelefono" promptText="3101234567" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <FlowPane hgap="12.0" vgap="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onAgregar" styleClass="btn-primary" text="Agregar cliente" />
                        <Button mnemonicParsing="false" onAction="#onActualizar" styleClass="btn-primary" text="Actualizar" />
                        <Button mnemonicParsing="false" onAction="#onEliminar" styleClass="btn-danger" text="Eliminar" />
                        <Button mnemonicParsing="false" onAction="#onUsarCliente" styleClass="btn-secondary" text="Usar como cliente activo" />
                        <Button mnemonicParsing="false" onAction="#onLimpiar" styleClass="btn-secondary" text="Limpiar campos" />
                    </children>
                </FlowPane>

                <Label fx:id="lblEstado" wrapText="true" />
            </children>
        </VBox>

        <TableView fx:id="tablaClientes" minHeight="160.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCedula" text="Cédula" />
                <TableColumn fx:id="colNombre" text="Nombre" />
                <TableColumn fx:id="colCorreo" text="Correo" />
                <TableColumn fx:id="colTelefono" text="Teléfono" />
                <TableColumn fx:id="colRango" text="Rango" />
                <TableColumn fx:id="colPuntos" text="Puntos" />
                <TableColumn fx:id="colSaldo" text="Saldo total" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
