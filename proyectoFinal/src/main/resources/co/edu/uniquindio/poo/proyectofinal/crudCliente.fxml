<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18.0" styleClass="vista" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinal.viewController.ClienteViewController">
    <padding>
        <Insets bottom="28.0" left="30.0" right="30.0" top="28.0" />
    </padding>
    <children>
        <Label styleClass="text-title" text="Gestión de Clientes" />

        <VBox spacing="12.0" styleClass="card">
            <children>
                <GridPane hgap="12.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="80.0" prefWidth="80.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints minWidth="80.0" prefWidth="80.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <children>
                        <Label styleClass="text-subtitle" text="Cédula" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtCedula" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label styleClass="text-subtitle" text="Nombre" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <TextField fx:id="txtNombre" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                        <Label styleClass="text-subtitle" text="Correo" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtCorreo" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label styleClass="text-subtitle" text="Teléfono" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <TextField fx:id="txtTelefono" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                    </children>
                </GridPane>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onAgregar" styleClass="btn-primary" text="Agregar" />
                        <Button mnemonicParsing="false" onAction="#onActualizar" styleClass="btn-primary" text="Actualizar" />
                        <Button mnemonicParsing="false" onAction="#onEliminar" styleClass="btn-danger" text="Eliminar" />
                        <Button mnemonicParsing="false" onAction="#onUsarCliente" styleClass="btn-secondary" text="Usar como cliente activo" />
                        <Button mnemonicParsing="false" onAction="#onLimpiar" styleClass="btn-secondary" text="Limpiar" />
                        <Label fx:id="lblEstado" wrapText="true" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <TableView fx:id="tablaClientes" minHeight="160.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCedula" text="Cédula" />
                <TableColumn fx:id="colNombre" text="Nombre" />
                <TableColumn fx:id="colCorreo" text="Correo" />
                <TableColumn fx:id="colTelefono" text="Teléfono" />
                <TableColumn fx:id="colRango" text="Rango" />
                <TableColumn fx:id="colPuntos" text="Puntos" />
                <TableColumn fx:id="colSaldo" text="Saldo total" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
