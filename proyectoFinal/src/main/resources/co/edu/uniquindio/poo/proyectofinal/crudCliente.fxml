<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" styleClass="root" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinal.viewController.ClienteViewController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
            <children>

                <!-- Encabezado con Botón de Volver -->
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onVolver" styleClass="sidebar-btn" text="⬅ Volver al Dashboard" />
                        <Label styleClass="text-title" text="Gestión de Clientes" />
                    </children>
                </HBox>

                <!-- Formulario (Tarjeta) -->
                <VBox spacing="15.0" styleClass="card">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label prefWidth="80.0" styleClass="text-subtitle" text="Cédula:" />
                            <TextField fx:id="txtCedula" styleClass="text-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label prefWidth="80.0" styleClass="text-subtitle" text="Nombre:" />
                            <TextField fx:id="txtNombre" styleClass="text-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label prefWidth="80.0" styleClass="text-subtitle" text="Correo:" />
                            <TextField fx:id="txtCorreo" styleClass="text-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label prefWidth="80.0" styleClass="text-subtitle" text="Teléfono:" />
                            <TextField fx:id="txtTelefono" styleClass="text-field" HBox.hgrow="ALWAYS" />
                        </HBox>

                        <!-- Botones de Acción -->
                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button mnemonicParsing="false" styleClass="btn-primary" text="Agregar Cliente" />
                                <Button mnemonicParsing="false" styleClass="btn-primary" text="Actualizar" />
                                <!-- Botón rojo para eliminar -->
                                <Button mnemonicParsing="false" onAction="#onEliminar" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 25;" text="Eliminar" />
                                <Button mnemonicParsing="false" onAction="#onLimpiar" styleClass="sidebar-btn" text="Limpiar Campos" />
                            </children>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                </VBox>

                <!-- Tabla de Clientes -->
                <TableView fx:id="tablaClientes" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Cédula" />
                        <TableColumn text="Nombre" />
                        <TableColumn text="Correo" />
                        <TableColumn text="Teléfono" />
                        <TableColumn text="Rango" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>