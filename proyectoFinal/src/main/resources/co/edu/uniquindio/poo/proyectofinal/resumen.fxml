<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="22.0" styleClass="vista" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinal.viewController.ResumenViewController">
    <padding>
        <Insets bottom="28.0" left="30.0" right="30.0" top="28.0" />
    </padding>
    <children>
        <Label styleClass="text-title" text="Resumen de Cuenta" />

        <HBox spacing="20.0">
            <children>
                <VBox prefHeight="140.0" spacing="10.0" styleClass="wallet-card" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-text-fill: #e2e8f0;" text="Saldo total" />
                        <Label fx:id="lblSaldo" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;" />
                        <Label fx:id="lblDetalleSaldo" style="-fx-text-fill: white;" />
                    </children>
                </VBox>
                <VBox prefHeight="140.0" spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="text-subtitle" text="Puntos acumulados" />
                        <Label fx:id="lblPuntos" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <Label fx:id="lblRango" style="-fx-text-fill: #a855f7; -fx-font-weight: bold;" />
                                <Button mnemonicParsing="false" onAction="#onCanjear" styleClass="btn-primary" text="Canjear Beneficios" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox spacing="12.0" styleClass="card" VBox.vgrow="ALWAYS">
            <children>
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="Transacciones recientes" />
                <TableView fx:id="tabla" minHeight="140.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFecha" text="Fecha" />
                        <TableColumn fx:id="colTipo" text="Tipo" />
                        <TableColumn fx:id="colMonedero" text="Monedero" />
                        <TableColumn fx:id="colMonto" text="Monto" />
                        <TableColumn fx:id="colEstado" text="Estado" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
